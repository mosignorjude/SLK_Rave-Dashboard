rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function approved() { return signedIn() && request.auth.token.email_verified == true && profile().status == 'approved'; }
    function admin() { return approved() && profile().role == 'admin'; }
    function financeReader() { return approved() && profile().role in ['admin', 'executive', 'member', 'guest']; }
    function financeWriter() { return approved() && profile().role in ['admin', 'executive']; }
    function ticketAgent() { return approved() && profile().role in ['admin', 'executive', 'member']; }
    function createdAtServerTimeIfPresent() {
      return !request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == request.time;
    }
    function updatedAtServerTimeIfChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
        || request.resource.data.updatedAt == request.time;
    }
    function createdAtServerTimeIfChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
        || request.resource.data.createdAt == request.time;
    }
    function allowedActivityAction(action) {
      return action in ['ticket.sale','ticket.sale.deleted','expense.created','expense.updated','expense.deleted','revenue.created','revenue.updated','revenue.deleted','user.signup','user.master_admin_claimed','user.approve','user.reject','user.role','user.suspend','user.reactivate','configuration.updated'];
    }
    function activityExpenseUpdateMatches(id) {
      let before = get(/databases/$(database)/documents/expenses/$(id));
      let after = getAfter(/databases/$(database)/documents/expenses/$(id));
      let amountChanged = before.data.amount != after.data.amount;
      let statusChanged = before.data.status != after.data.status;
      return exists(/databases/$(database)/documents/expenses/$(id)) && existsAfter(/databases/$(database)/documents/expenses/$(id))
        && after.data.updatedBy == request.auth.uid
        && after.data.updatedAt == request.time
        && (!(amountChanged || statusChanged) || validReason(request.resource.data.get('reason', null)))
        && ((!amountChanged && !request.resource.data.keys().hasAny(['previousAmount','newAmount']))
          || (amountChanged
            && request.resource.data.previousAmount == before.data.amount
            && request.resource.data.newAmount == after.data.amount
            && after.data.previousAmount == before.data.amount));
    }
    function activityRevenueUpdateMatches(id) {
      let before = get(/databases/$(database)/documents/revenues/$(id));
      let after = getAfter(/databases/$(database)/documents/revenues/$(id));
      return exists(/databases/$(database)/documents/revenues/$(id))
        && existsAfter(/databases/$(database)/documents/revenues/$(id))
        && after.data.updatedBy == request.auth.uid
        && after.data.updatedAt == request.time
        && ((before.data.amount == after.data.amount && before.data.status == after.data.status)
          || validReason(request.resource.data.get('reason', null)));
    }
    function validReason(reason) {
      return reason is string && reason.size() >= 1 && reason.size() <= 500
        && reason.matches('.*\\S.*');
    }
    function activityUserChangeMatches(action, id) {
      let before = get(/databases/$(database)/documents/users/$(id));
      let after = getAfter(/databases/$(database)/documents/users/$(id));
      let afterPublic = getAfter(/databases/$(database)/documents/usersPublic/$(id));
      return id != request.auth.uid
        && afterPublic.data.role == after.data.role
        && afterPublic.data.status == after.data.status
        && ((action == 'user.role' && before.data.status == 'approved' && after.data.status == before.data.status
            && after.data.role in ['admin','executive','member','guest'] && after.data.role != before.data.role)
          || (action == 'user.approve' && before.data.status == 'pending' && after.data.status == 'approved'
            && after.data.role in ['admin','executive','member','guest'])
          || (action == 'user.reject' && before.data.status == 'pending' && after.data.status == 'rejected'
            && after.data.role == before.data.role)
          || (action == 'user.suspend' && before.data.status == 'approved' && after.data.status == 'suspended'
            && after.data.role == before.data.role)
          || (action == 'user.reactivate' && before.data.status in ['suspended','rejected'] && after.data.status == 'approved'
            && after.data.role == before.data.role));
    }
    function activityTargetMatches(logId) {
      let action = request.resource.data.action;
      let id = request.resource.data.targetId;
      let target = request.resource.data.targetType;
      return action == 'ticket.sale' ? (target == 'ticketSales'
          && !exists(/databases/$(database)/documents/ticketSales/$(id))
          && existsAfter(/databases/$(database)/documents/ticketSales/$(id))
          && getAfter(/databases/$(database)/documents/ticketSales/$(id)).data.agentId == request.auth.uid)
        : action == 'ticket.sale.deleted' ? (target == 'ticketSales'
          && exists(/databases/$(database)/documents/ticketSales/$(id))
          && !existsAfter(/databases/$(database)/documents/ticketSales/$(id))
          && request.resource.data.keys().hasAny(['snapshot'])
          && auditSnapshotMatches(request.resource.data.snapshot,get(/databases/$(database)/documents/ticketSales/$(id)).data)
          && validReason(request.resource.data.get('reason',null))
          && profile().role == 'admin'
          && (!exists(/databases/$(database)/documents/ticketTiers/$(get(/databases/$(database)/documents/ticketSales/$(id)).data.tierId))
            || (existsAfter(/databases/$(database)/documents/ticketTiers/$(get(/databases/$(database)/documents/ticketSales/$(id)).data.tierId))
              && getAfter(/databases/$(database)/documents/ticketTiers/$(get(/databases/$(database)/documents/ticketSales/$(id)).data.tierId)).data.lastDeletedSaleId == id
              && getAfter(/databases/$(database)/documents/ticketTiers/$(get(/databases/$(database)/documents/ticketSales/$(id)).data.tierId)).data.auditLogId == logId
              && getAfter(/databases/$(database)/documents/ticketTiers/$(get(/databases/$(database)/documents/ticketSales/$(id)).data.tierId)).data.sold
                == get(/databases/$(database)/documents/ticketTiers/$(get(/databases/$(database)/documents/ticketSales/$(id)).data.tierId)).data.sold - get(/databases/$(database)/documents/ticketSales/$(id)).data.quantity
              && getAfter(/databases/$(database)/documents/ticketTiers/$(get(/databases/$(database)/documents/ticketSales/$(id)).data.tierId)).data.updatedAt == request.time)))
        : action == 'expense.created' ? (target == 'expenses'
          && !exists(/databases/$(database)/documents/expenses/$(id))
          && existsAfter(/databases/$(database)/documents/expenses/$(id))
          && getAfter(/databases/$(database)/documents/expenses/$(id)).data.createdBy == request.auth.uid)
        : action == 'revenue.created' ? (target == 'revenues'
          && !exists(/databases/$(database)/documents/revenues/$(id))
          && existsAfter(/databases/$(database)/documents/revenues/$(id))
          && getAfter(/databases/$(database)/documents/revenues/$(id)).data.createdBy == request.auth.uid)
        : action == 'expense.updated' ? (target == 'expenses'
          && activityExpenseUpdateMatches(id))
        : action == 'revenue.updated' ? (target == 'revenues'
          && activityRevenueUpdateMatches(id))
        : action == 'expense.deleted' ? (target == 'expenses'
          && exists(/databases/$(database)/documents/expenses/$(id))
          && !existsAfter(/databases/$(database)/documents/expenses/$(id))
          && request.resource.data.keys().hasAny(['snapshot']) && auditSnapshotMatches(request.resource.data.snapshot,get(/databases/$(database)/documents/expenses/$(id)).data)
          && (get(/databases/$(database)/documents/expenses/$(id)).data.createdBy == request.auth.uid || profile().role == 'admin'))
        : action == 'revenue.deleted' ? (target == 'revenues'
          && exists(/databases/$(database)/documents/revenues/$(id))
          && !existsAfter(/databases/$(database)/documents/revenues/$(id))
          && request.resource.data.keys().hasAny(['snapshot']) && auditSnapshotMatches(request.resource.data.snapshot,get(/databases/$(database)/documents/revenues/$(id)).data)
          && (get(/databases/$(database)/documents/revenues/$(id)).data.createdBy == request.auth.uid || profile().role == 'admin'))
        : action in ['user.approve','user.reject','user.role','user.suspend','user.reactivate'] ? (target == 'users'
          && activityUserChangeMatches(action,id))
        : action == 'configuration.updated' ? (target == 'settings' && id == 'workspace'
          && existsAfter(/databases/$(database)/documents/settings/workspace)
          && getAfter(/databases/$(database)/documents/settings/workspace).data.auditLogId == logId
          && getAfter(/databases/$(database)/documents/settings/workspace).data.updatedAt == request.time)
        : false;
    }
    function validMoney(v) { return v is int && v >= 0 && v <= 1000000000000; }
    function validDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validAuditSnapshot(snapshot) {
      return snapshot is map;
    }
    function validAuditChanges(changes) {
      return changes is map && changes.keys().hasOnly(['before','after']) && changes.keys().hasAll(['before','after']);
    }
    function validConfigurationChanges(changes) {
      return changes is map && changes.size() <= 120;
    }
    function auditSnapshotMatches(snapshot, record) {
      return validAuditSnapshot(snapshot) && snapshot == record;
    }
    function financeAuditChangesMatch(changes, before, after) {
      return validAuditChanges(changes) && changes.before == before && changes.after == after;
    }
    function linkedAudit(logId, action, target, targetId) {
      let audit = getAfter(/databases/$(database)/documents/activityLogs/$(logId));
      return logId is string && existsAfter(/databases/$(database)/documents/activityLogs/$(logId))
        && audit.data.actorId == request.auth.uid && audit.data.action == action
        && audit.data.label == action && audit.data.targetType == target && audit.data.targetId == targetId
        && (action == 'expense.updated' ? (audit.data.keys().hasAny(['changes'])
          && financeAuditChangesMatch(audit.data.changes,get(/databases/$(database)/documents/expenses/$(targetId)).data,getAfter(/databases/$(database)/documents/expenses/$(targetId)).data))
          : action == 'revenue.updated' ? (audit.data.keys().hasAny(['changes'])
            && financeAuditChangesMatch(audit.data.changes,get(/databases/$(database)/documents/revenues/$(targetId)).data,getAfter(/databases/$(database)/documents/revenues/$(targetId)).data))
          : true);
    }
    function linkedUserAudit(logId, targetId) {
      let audit = getAfter(/databases/$(database)/documents/activityLogs/$(logId));
      return logId is string && existsAfter(/databases/$(database)/documents/activityLogs/$(logId))
        && audit.data.actorId == request.auth.uid && audit.data.targetType == 'users'
        && audit.data.targetId == targetId
        && audit.data.action in ['user.signup','user.master_admin_claimed','user.approve','user.reject','user.role','user.suspend','user.reactivate'];
    }
    function workspaceAudit() {
      let marker = getAfter(/databases/$(database)/documents/settings/workspace);
      return existsAfter(/databases/$(database)/documents/settings/workspace)
        && marker.data.updatedAt == request.time
        && linkedAudit(marker.data.auditLogId,'configuration.updated','settings','workspace');
    }
    function configurationPathAudited(collectionName, id) {
      let marker = getAfter(/databases/$(database)/documents/settings/workspace);
      let audit = getAfter(/databases/$(database)/documents/activityLogs/$(marker.data.auditLogId));
      let path = collectionName + '/' + id;
      return audit.data.changes is map && audit.data.changes.keys().hasAny([path]);
    }

    match /users/{uid} {
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['uid','fullName','username','usernameKey','email','role','status','createdAt','auditLogId'])
        && linkedAudit(request.resource.data.auditLogId,'user.signup','users',uid)
        && request.resource.data.uid == uid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_-]{3,24}$')
        && request.resource.data.usernameKey == request.resource.data.username
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.role == 'guest'
        && request.resource.data.status == 'approved'
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow read: if self(uid) || admin();
      allow update: if admin() && uid != request.auth.uid
        && resource.data.get('isMasterAdmin', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status','updatedAt','auditLogId'])
        && updatedAtServerTimeIfChanged()
        && linkedUserAudit(request.resource.data.auditLogId,uid)
        && request.resource.data.auditLogId == getAfter(/databases/$(database)/documents/usersPublic/$(uid)).data.auditLogId
        && (request.resource.data.role in ['admin','executive','member','guest'] || request.resource.data.role == null)
        && request.resource.data.status in ['approved','rejected','suspended'];
      allow update: if self(uid)
        && resource.data.role == 'guest'
        && resource.data.status == 'approved'
        && resource.data.email == 'carpentersfamily001@gmail.com'
        && request.auth.token.email == 'carpentersfamily001@gmail.com'
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/settings/masterAdmin)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status','isMasterAdmin','updatedAt','auditLogId'])
        && updatedAtServerTimeIfChanged()
        && linkedAudit(request.resource.data.auditLogId,'user.master_admin_claimed','users',uid)
        && request.resource.data.role == 'admin'
        && request.resource.data.status == 'approved'
        && request.resource.data.isMasterAdmin == true;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','username','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username && username.matches('^[a-z0-9_-]{3,24}$')
        && request.resource.data.createdAt == request.time
        && linkedAudit(getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.auditLogId,'user.signup','users',request.resource.data.uid)
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow read, update, delete: if false;
    }

    match /usersPublic/{uid} {
      allow create: if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'guest'
        && request.resource.data.status == 'approved'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['uid','fullName','username','email','role','status','createdAt','auditLogId'])
        && linkedAudit(request.resource.data.auditLogId,'user.signup','users',uid)
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 100
        && request.resource.data.username is string && request.resource.data.username.matches('^[a-z0-9_-]{3,24}$')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.username == request.resource.data.username;
      allow read: if admin();
      allow update: if admin() && uid != request.auth.uid
        && get(/databases/$(database)/documents/users/$(uid)).data.get('isMasterAdmin', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status','updatedAt','auditLogId'])
        && updatedAtServerTimeIfChanged()
        && linkedUserAudit(request.resource.data.auditLogId,uid)
        && request.resource.data.auditLogId == getAfter(/databases/$(database)/documents/users/$(uid)).data.auditLogId
        && (request.resource.data.role in ['admin','executive','member','guest'] || request.resource.data.role == null)
        && request.resource.data.status in ['approved','rejected','suspended'];
      allow update: if self(uid)
        && request.auth.token.email == 'carpentersfamily001@gmail.com'
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/settings/masterAdmin)
        && request.resource.data.role == 'admin' && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status','updatedAt','auditLogId'])
        && updatedAtServerTimeIfChanged()
        && linkedAudit(request.resource.data.auditLogId,'user.master_admin_claimed','users',uid)
      allow delete: if false;
    }

    match /ticketTiers/{id} {
      allow read: if financeReader();
      allow create: if admin() && workspaceAudit() && configurationPathAudited('ticketTiers',id) && createdAtServerTimeIfPresent()
        && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time)
        && request.resource.data.sold == 0
        && request.resource.data.capacity is int && request.resource.data.capacity >= 0
        && validMoney(request.resource.data.price);
      allow update: if admin() && workspaceAudit() && configurationPathAudited('ticketTiers',id) && updatedAtServerTimeIfChanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price','capacity','active','updatedAt'])
        && validMoney(request.resource.data.price)
        && request.resource.data.capacity is int && request.resource.data.capacity >= resource.data.sold;
      allow update: if ticketAgent() && updatedAtServerTimeIfChanged()
        && resource.data.sold is int && resource.data.sold >= 0
        && resource.data.capacity is int && resource.data.capacity >= resource.data.sold
        && validMoney(resource.data.price)
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold','lastSaleId','auditLogId','updatedAt'])
        && request.resource.data.auditLogId == getAfter(/databases/$(database)/documents/ticketSales/$(request.resource.data.lastSaleId)).data.auditLogId
        && getAfter(/databases/$(database)/documents/ticketSales/$(request.resource.data.lastSaleId)).data.tierId == id
        && request.resource.data.sold is int && request.resource.data.sold >= 0
        && request.resource.data.sold == resource.data.sold + getAfter(/databases/$(database)/documents/ticketSales/$(request.resource.data.lastSaleId)).data.quantity
        && request.resource.data.sold <= resource.data.capacity;
      allow update: if admin() && updatedAtServerTimeIfChanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold','lastDeletedSaleId','auditLogId','updatedAt'])
        && request.resource.data.lastDeletedSaleId is string
        && exists(/databases/$(database)/documents/ticketSales/$(request.resource.data.lastDeletedSaleId))
        && !existsAfter(/databases/$(database)/documents/ticketSales/$(request.resource.data.lastDeletedSaleId))
        && get(/databases/$(database)/documents/ticketSales/$(request.resource.data.lastDeletedSaleId)).data.tierId == id
        && request.resource.data.sold is int
        && request.resource.data.sold == resource.data.sold - get(/databases/$(database)/documents/ticketSales/$(request.resource.data.lastDeletedSaleId)).data.quantity
        && request.resource.data.sold >= 0
        && request.resource.data.auditLogId == request.resource.data.lastDeletedSaleId
        && linkedAudit(request.resource.data.auditLogId,'ticket.sale.deleted','ticketSales',request.resource.data.lastDeletedSaleId);
      allow delete: if admin() && workspaceAudit() && configurationPathAudited('ticketTiers',id);
    }

    match /ticketSales/{id} {
      allow get: if financeReader() || (ticketAgent()
        && (!exists(/databases/$(database)/documents/ticketSales/$(id))
          || resource.data.agentId == request.auth.uid));
      allow list: if financeReader();
      allow create: if ticketAgent()
        && request.resource.data.keys().hasOnly(['tierId','tierName','quantity','unitPrice','total','status','date','agent','agentId','createdBy','createdAt','auditLogId'])
        && linkedAudit(request.resource.data.auditLogId,'ticket.sale','ticketSales',id)
        && request.resource.data.tierId is string
        && request.resource.data.tierName is string && request.resource.data.tierName.size() >= 1 && request.resource.data.tierName.size() <= 80
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.agent == profile().fullName
        && request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 20
        && validMoney(request.resource.data.unitPrice)
        && validMoney(request.resource.data.total)
        && request.resource.data.total == request.resource.data.unitPrice * request.resource.data.quantity
        && request.resource.data.status == 'Paid' && validDate(request.resource.data.date)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/ticketTiers/$(request.resource.data.tierId))
        && getAfter(/databases/$(database)/documents/ticketTiers/$(request.resource.data.tierId)).data.lastSaleId == id
        && getAfter(/databases/$(database)/documents/ticketTiers/$(request.resource.data.tierId)).data.sold
          == get(/databases/$(database)/documents/ticketTiers/$(request.resource.data.tierId)).data.sold + request.resource.data.quantity
        && getAfter(/databases/$(database)/documents/ticketTiers/$(request.resource.data.tierId)).data.sold <= get(/databases/$(database)/documents/ticketTiers/$(request.resource.data.tierId)).data.capacity
        && getAfter(/databases/$(database)/documents/ticketTiers/$(request.resource.data.tierId)).data.active == true
        && request.resource.data.unitPrice == get(/databases/$(database)/documents/ticketTiers/$(request.resource.data.tierId)).data.price;
      allow update: if false;
      allow delete: if admin() && linkedAudit(id,'ticket.sale.deleted','ticketSales',id);
    }

    match /revenues/{id} {
      allow read: if financeReader();
      allow create: if financeWriter() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['title','category','categoryId','budgetAllocationId','amount','status','date','method','agent','createdBy','updatedBy','updatedAt','createdAt','auditLogId'])
        && linkedAudit(request.resource.data.auditLogId,'revenue.created','revenues',id)
        && request.resource.data.agent == profile().fullName
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 160
        && request.resource.data.category is string && request.resource.data.category.size() <= 60
        && request.resource.data.category != 'Ticket Sales'
        && validMoney(request.resource.data.amount) && request.resource.data.amount > 0
        && request.resource.data.status in ['Paid','Pending','Unpaid'] && validDate(request.resource.data.date)
        && request.resource.data.method is string && request.resource.data.method.size() <= 60
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time && request.resource.data.createdAt == request.time;
      allow update: if financeWriter() && (resource.data.createdBy == request.auth.uid || admin())
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','category','categoryId','categoryName','amount','status','date','method','updatedBy','updatedAt','auditLogId'])
        && linkedAudit(request.resource.data.auditLogId,'revenue.updated','revenues',id)
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 160
        && request.resource.data.category is string && request.resource.data.category.size() >= 1 && request.resource.data.category.size() <= 60
        && validMoney(request.resource.data.amount) && request.resource.data.amount > 0
        && request.resource.data.status in ['Paid','Pending','Unpaid'] && validDate(request.resource.data.date)
        && request.resource.data.method is string && request.resource.data.method.size() <= 60
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin()
        && linkedAudit(id,'revenue.deleted','revenues',id);
    }

    match /expenses/{id} {
      allow read: if financeReader();
      allow create: if financeWriter() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['title','category','budgetAllocationId','amount','status','date','method','agent','createdBy','updatedBy','updatedAt','createdAt','auditLogId'])
        && linkedAudit(request.resource.data.auditLogId,'expense.created','expenses',id)
        && request.resource.data.agent == profile().fullName
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 160
        && request.resource.data.category is string && request.resource.data.category.size() >= 1 && request.resource.data.category.size() <= 100
        && (!request.resource.data.keys().hasAny(['budgetAllocationId']) || request.resource.data.budgetAllocationId == null
          || (exists(/databases/$(database)/documents/budgetAllocations/$(request.resource.data.budgetAllocationId))
            && get(/databases/$(database)/documents/budgetAllocations/$(request.resource.data.budgetAllocationId)).data.category == request.resource.data.category))
        && request.resource.data.method is string && request.resource.data.method.size() <= 60
        && validMoney(request.resource.data.amount) && request.resource.data.amount > 0
        && request.resource.data.status in ['Paid','Pending','Deposit'] && validDate(request.resource.data.date)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time && request.resource.data.createdAt == request.time;
      allow update: if financeWriter()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','category','expenseCategoryId','budgetAllocationId','amount','previousAmount','status','date','updatedBy','updatedAt','auditLogId'])
        && linkedAudit(request.resource.data.auditLogId,'expense.updated','expenses',id)
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 160
        && request.resource.data.category is string && request.resource.data.category.size() >= 1 && request.resource.data.category.size() <= 100
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['budgetAllocationId']) || request.resource.data.budgetAllocationId == null
          || (exists(/databases/$(database)/documents/budgetAllocations/$(request.resource.data.budgetAllocationId))
            && get(/databases/$(database)/documents/budgetAllocations/$(request.resource.data.budgetAllocationId)).data.category == request.resource.data.category))
        && validMoney(request.resource.data.amount) && request.resource.data.amount > 0
        && (request.resource.data.status in ['Paid','Pending','Deposit']
          || (resource.data.status == 'Unpaid' && request.resource.data.status == 'Unpaid'))
        && validDate(request.resource.data.date)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount'])
          || (request.resource.data.previousAmount is int && request.resource.data.previousAmount == resource.data.amount))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['previousAmount'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount'])
            && request.resource.data.previousAmount is int && request.resource.data.previousAmount == resource.data.amount))
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin()
        && linkedAudit(id,'expense.deleted','expenses',id);
    }

    match /revenueCategories/{id} {
      allow read: if financeReader();
      allow create: if admin() && workspaceAudit() && configurationPathAudited('revenueCategories',id) && createdAtServerTimeIfPresent()
        && request.resource.data.get('updatedAt',request.time) == request.time && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.get('systemControlled', false) is bool
        && (request.resource.data.get('systemControlled', false) != true || (id == 'ticket-sales' && request.resource.data.name == 'Ticket Sales'));
      allow update: if admin() && workspaceAudit() && configurationPathAudited('revenueCategories',id) && updatedAtServerTimeIfChanged() && resource.data.get('systemControlled', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','active','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60;
      allow delete: if false;
    }
    match /expenseCategories/{id} {
      allow read: if financeReader();
      allow create: if admin() && workspaceAudit() && configurationPathAudited('expenseCategories',id) && createdAtServerTimeIfPresent()
        && request.resource.data.get('updatedAt',request.time) == request.time && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60;
      allow update: if admin() && workspaceAudit() && configurationPathAudited('expenseCategories',id) && updatedAtServerTimeIfChanged() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','active','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60;
      allow delete: if false;
    }
    match /budgetAllocations/{id} {
      allow read: if financeReader();
      allow create: if admin() && workspaceAudit() && configurationPathAudited('budgetAllocations',id)
        && request.resource.data.keys().hasOnly(['budgetId','categoryId','category','percent','amount','createdAt','updatedAt'])
        && request.resource.data.budgetId == 'event-2026'
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2 && request.resource.data.category.size() <= 100
        && (!request.resource.data.keys().hasAny(['categoryId']) || (request.resource.data.categoryId is string && request.resource.data.categoryId.size() <= 100))
        && request.resource.data.percent is number && request.resource.data.percent >= 0 && request.resource.data.percent <= 100
        && validMoney(request.resource.data.amount)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if admin() && workspaceAudit() && configurationPathAudited('budgetAllocations',id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['budgetId','categoryId','category','percent','amount','updatedAt'])
        && request.resource.data.budgetId == 'event-2026'
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2 && request.resource.data.category.size() <= 100
        && (!request.resource.data.keys().hasAny(['categoryId']) || (request.resource.data.categoryId is string && request.resource.data.categoryId.size() <= 100))
        && request.resource.data.percent is number && request.resource.data.percent >= 0 && request.resource.data.percent <= 100
        && validMoney(request.resource.data.amount)
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin() && workspaceAudit() && configurationPathAudited('budgetAllocations',id);
    }
    match /budgets/{id} {
      allow read: if financeReader();
      allow create: if admin() && workspaceAudit() && configurationPathAudited('budgets',id)
        && id == 'event-2026'
        && request.resource.data.keys().hasOnly(['name','totalAmount','year','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && validMoney(request.resource.data.totalAmount) && request.resource.data.totalAmount > 0
        && request.resource.data.year is int
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if admin() && workspaceAudit() && configurationPathAudited('budgets',id)
        && id == 'event-2026'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','totalAmount','year','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && validMoney(request.resource.data.totalAmount) && request.resource.data.totalAmount > 0
        && request.resource.data.year is int && request.resource.data.updatedAt == request.time;
    }
    match /settings/{id} {
      allow read: if admin();
      allow create: if admin() && id == 'workspace'
          && request.resource.data.auditLogId is string && request.resource.data.updatedAt == request.time
          && linkedAudit(request.resource.data.auditLogId,'configuration.updated','settings','workspace')
        || (admin() && id != 'masterAdmin' && id != 'workspace' && workspaceAudit() && configurationPathAudited('settings',id)
          && createdAtServerTimeIfPresent() && request.resource.data.get('updatedAt',request.time) == request.time)
        || (id == 'masterAdmin' && signedIn() && request.auth.token.email == 'carpentersfamily001@gmail.com'
          && request.auth.token.email_verified == true && request.resource.data.uid == request.auth.uid
          && createdAtServerTimeIfPresent()
          && !exists(/databases/$(database)/documents/settings/masterAdmin)
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.isMasterAdmin == true
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow update: if admin() && id == 'workspace'
          && request.resource.data.auditLogId is string && request.resource.data.updatedAt == request.time
          && linkedAudit(request.resource.data.auditLogId,'configuration.updated','settings','workspace')
        || (admin() && id != 'masterAdmin' && id != 'workspace' && workspaceAudit() && configurationPathAudited('settings',id)
          && updatedAtServerTimeIfChanged() && createdAtServerTimeIfChanged());
      allow delete: if false;
    }
    match /alertDismissals/{uid}/items/{alertId} {
      allow read: if self(uid) && approved();
      allow create, update: if self(uid) && approved()
        && request.resource.data.keys().hasOnly(['alertId','dismissedAt'])
        && request.resource.data.keys().hasAll(['alertId','dismissedAt'])
        && request.resource.data.alertId is string
        && request.resource.data.alertId == alertId
        && request.resource.data.alertId.size() >= 1
        && request.resource.data.alertId.size() <= 150
        && request.resource.data.dismissedAt == request.time;
      allow delete: if self(uid) && approved();
    }
    match /activityLogs/{id} {
      allow read: if admin();
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['actor','actorId','action','label','targetType','targetId','createdAt','previousAmount','newAmount','reason','changes','snapshot'])
        && (!request.resource.data.keys().hasAny(['changes']) || ((request.resource.data.action in ['expense.updated','revenue.updated'] && validAuditChanges(request.resource.data.changes))
          || (request.resource.data.action == 'configuration.updated' && validConfigurationChanges(request.resource.data.changes))))
        && (!request.resource.data.keys().hasAny(['snapshot']) || (request.resource.data.action in ['ticket.sale.deleted','expense.deleted','revenue.deleted'] && validAuditSnapshot(request.resource.data.snapshot)))
        && (request.resource.data.get('action','') in ['ticket.sale.deleted','expense.deleted','revenue.deleted','user.approve','user.role','user.suspend','user.reactivate']
          ? validReason(request.resource.data.get('reason', null))
          : (!request.resource.data.keys().hasAny(['reason']) || validReason(request.resource.data.reason)))
        && (!request.resource.data.keys().hasAny(['previousAmount','newAmount'])
          || (request.resource.data.action == 'expense.updated'
            && request.resource.data.keys().hasAll(['previousAmount','newAmount'])
            && validMoney(request.resource.data.previousAmount)
            && validMoney(request.resource.data.newAmount)))
        && request.resource.data.actor is string && request.resource.data.actor.size() >= 1 && request.resource.data.actor.size() <= 100
        && request.resource.data.action is string && request.resource.data.action.size() >= 1 && request.resource.data.action.size() <= 60
        && allowedActivityAction(request.resource.data.action)
        && request.resource.data.label == request.resource.data.action
        && request.resource.data.targetType is string && request.resource.data.targetType.size() >= 1 && request.resource.data.targetType.size() <= 30
        && request.resource.data.targetId is string && request.resource.data.targetId.size() >= 1 && request.resource.data.targetId.size() <= 150
        && request.resource.data.createdAt == request.time
        && ((approved() && request.resource.data.action != 'user.signup'
            && request.resource.data.action != 'user.master_admin_claimed'
            && request.resource.data.actor == profile().fullName
            && activityTargetMatches(id)
            && ((request.resource.data.action == 'ticket.sale' && profile().role in ['admin','executive','member'])
              || (request.resource.data.action == 'ticket.sale.deleted' && profile().role == 'admin')
              || (request.resource.data.action in ['expense.created','expense.updated','expense.deleted','revenue.created','revenue.updated','revenue.deleted'] && profile().role in ['admin','executive'])
              || (request.resource.data.action in ['user.approve','user.reject','user.role','user.suspend','user.reactivate'] && profile().role == 'admin')
              || (request.resource.data.action == 'configuration.updated' && profile().role == 'admin')))
          || (request.resource.data.action == 'user.signup'
          && request.resource.data.targetType == 'users'
          && request.resource.data.targetId == request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == request.auth.token.email
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guest'
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
          && request.resource.data.actor == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName)
          || (request.resource.data.action == 'user.master_admin_claimed'
            && request.resource.data.targetType == 'users'
            && request.resource.data.targetId == request.auth.uid
            && request.auth.token.email == 'carpentersfamily001@gmail.com'
            && request.auth.token.email_verified == true
            && getAfter(/databases/$(database)/documents/settings/masterAdmin).data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.isMasterAdmin == true
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
            && request.resource.data.actor == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName));
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
